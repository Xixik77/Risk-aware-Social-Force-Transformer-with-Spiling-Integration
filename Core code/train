@torch.no_grad()
def get_cls_label(gt, motion_modes):
    """
    gt:           [B, T_pred, 2]
    motion_modes: [K, T_pred, 2]
    return:
      closest_mode_indices [B] （给 CE 用）
      soft_label           [B,K]（如果你以后想用软标签，留着）
    """
    B = gt.size(0)
    gt_flat = gt.reshape(B, -1).unsqueeze(1)                    # [B,1,T*2]
    modes_flat = motion_modes.reshape(motion_modes.size(0), -1) # [K,T*2]
    modes_flat = modes_flat.unsqueeze(0)                        # [1,K,T*2]
    dist = torch.norm(gt_flat - modes_flat, dim=-1)             # [B,K]
    closest = torch.argmin(dist, dim=-1)                        # [B]
    soft = F.softmax(-dist, dim=-1)                             # [B,K]
    return closest, soft

def train_one_epoch(epoch):
    model.train()
    total = 0.0
    for i, (ped, neis, mask) in enumerate(train_loader):
        ped = ped.to(device)          # [B, T_all, 2]
        neis = neis.to(device)        # [B, N, T_all, 2]（假设你的 collate 就是这样）
        mask = mask.to(device)        # 可能是 [B,N] 或 [B,N,N]

        # 数据集特例缩放（沿用你的逻辑）
        if args.dataset_name == 'eth':
            ped[:, :, 0] = ped[:, :, 0] * args.data_scaling[0]
            ped[:, :, 1] = ped[:, :, 1] * args.data_scaling[1]

        # 全局尺度增强（你的代码）
        scale = (torch.randn(ped.shape[0], device=device) * 0.05 + 1.0).view(-1, 1, 1)
        ped = ped * scale
        neis = neis * scale.view(-1, 1, 1, 1)

        # 切分观测/真值
        ped_obs = ped[:, :args.obs_len]       # [B, T_obs, 2]
        gt = ped[:, args.obs_len:]            # [B, T_pred, 2]
        neis_obs = neis[:, :, :args.obs_len]  # [B, N, T_obs, 2]

        # 折叠邻居 mask 到 [B,N]
        if mask.dim() == 3:                   # [B,N,N] -> [B,N]
            valid_nei = mask.any(dim=-1)
        else:                                  # [B,N]
            valid_nei = mask

        # 模式标签（CE 用 closest 索引；soft_label 可保留备用）
        closest_mode_indices, soft_label = get_cls_label(gt, motion_modes)

        optimizer.zero_grad()
        # 前向：训练路径
        pred_traj, scores = model(
            ped_obs=ped_obs,
            neis_obs=neis_obs,
            motion_modes=motion_modes,
            valid_nei_mask=valid_nei,
            closest_mode_indices=closest_mode_indices,
            test=False
        )  # pred_traj:[B,T_pred,2]  scores:[B,K]

        reg_loss = reg_criterion(pred_traj, gt)                       # 回归
        cls_loss = cls_criterion(scores, closest_mode_indices)        # 分类（CE）
        # 如果想用软标签： cls_loss = F.kl_div(F.log_softmax(scores, dim=-1), soft_label, reduction='batchmean')
        loss = reg_loss + cls_loss

        loss.backward()
        optimizer.step()

        total += loss.item()

    return total / max(1, len(train_loader))

@torch.no_grad()
def evaluate():
    model.eval()
    ade_sum, fde_sum, num_traj = 0.0, 0.0, 0

    for ped, neis, mask in test_loader:
        ped = ped.to(device)
        neis = neis.to(device)
        mask = mask.to(device)

        ped_obs = ped[:, :args.obs_len]
        gt = ped[:, args.obs_len:]
        neis_obs = neis[:, :, :args.obs_len]

        if mask.dim() == 3:
            valid_nei = mask.any(dim=-1)
        else:
            valid_nei = mask

        # 推理：top-k（默认取 20，你可以在模型里或这里改）
        pred_trajs, scores = model(
            ped_obs=ped_obs,
            neis_obs=neis_obs,
            motion_modes=motion_modes,
            valid_nei_mask=valid_nei,
            closest_mode_indices=None,    # 测试不会用
            test=True,
            num_k=20
        )                                  # [B, K', T_pred, 2]

        B, Kp, T, _ = pred_trajs.shape
        gt_ = gt.unsqueeze(1).expand(B, Kp, T, 2)                    # [B,K',T,2]
        dist = torch.norm(pred_trajs - gt_, dim=-1)                  # [B,K',T]
        ade = dist.mean(dim=-1)                                      # [B,K']
        fde = dist[:, :, -1]                                         # [B,K']
        min_ade = ade.min(dim=-1).values.sum().item()
        min_fde = fde.min(dim=-1).values.sum().item()

        ade_sum += min_ade
        fde_sum += min_fde
        num_traj += B

    ade = ade_sum / num_traj
    fde = fde_sum / num_traj
    return ade, fde, num_traj

