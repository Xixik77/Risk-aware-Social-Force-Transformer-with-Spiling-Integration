class LogSaver:
    def __init__(self, save_dir):
        self.save_dir = save_dir
        self.records = []
        self.csv_path = os.path.join(save_dir, "training_log.csv")

    def add(self, ep, train_loss, ade, fde, alpha):
        record = {
            "epoch": ep,
            "train_loss": train_loss,
            "ade": ade,
            "fde": fde,
            "alpha": alpha
        }
        self.records.append(record)

    def save_csv(self):
        keys = ["epoch", "train_loss", "ade", "fde", "alpha"]
        with open(self.csv_path, "w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=keys)
            writer.writeheader()
            for r in self.records:
                writer.writerow(r)
        print("日志已保存到:", self.csv_path)

    def plot_curves(self):
        epochs = [r["epoch"] for r in self.records]
        loss = [r["train_loss"] for r in self.records]
        ade = [r["ade"] for r in self.records]
        fde = [r["fde"] for r in self.records]
        alpha = [r["alpha"] for r in self.records]

        # loss 曲线
        plt.figure()
        plt.plot(epochs, loss)
        plt.xlabel("epoch")
        plt.ylabel("loss")
        plt.title("Loss Curve")
        plt.grid()
        plt.savefig(os.path.join(self.save_dir, "loss_curve.png"))

        # ADE/FDE
        plt.figure()
        plt.plot(epochs, ade, label="ADE")
        plt.plot(epochs, fde, label="FDE")
        plt.legend()
        plt.xlabel("epoch")
        plt.ylabel("error")
        plt.title("ADE / FDE Curve")
        plt.grid()
        plt.savefig(os.path.join(self.save_dir, "ade_fde_curve.png"))

        # alpha 曲线
        plt.figure()
        plt.plot(epochs, alpha)
        plt.xlabel("epoch")
        plt.ylabel("alpha")
        plt.title("Alpha Curve (ANN weight)")
        plt.grid()
        plt.savefig(os.path.join(self.save_dir, "alpha_curve.png"))

        print("训练曲线保存完成")


