import torch
import torch.nn as nn
import math
from torch.nn import functional as F



# ---------------- SNN：类 LIF 层（顺序维上迭代） ----------------
class LIFLayer(nn.Module):
    """
    简化版 LIF：v_t = decay * v_{t-1} + W*x_t
    产生“脉冲” s_t = H(v_t - v_th) （训练用直通梯度），
    输出用两种可选 readout：'mem'（膜电位）或 'spike'（脉冲）。
    为了对齐维度，先将输入 x 映射到 embed_size。
    """
    def __init__(self, embed_size, v_th=1.0, tau=2.0, readout="mem"):
        super().__init__()
        self.embed_size = embed_size
        self.v_th = v_th
        self.tau = tau
        self.decay = math.exp(-1.0 / tau)  # (0,1) 的衰减因子
        self.in_proj = nn.Linear(embed_size, embed_size, bias=True)
        assert readout in ("mem", "spike")
        self.readout = readout

    def forward(self, x):
        """
        x: [B, K, E]  —— K 是解码序列长度
        return: [B, K, E]
        """
        B, K, E = x.shape
        v = x.new_zeros(B, E)  # 初始膜电位
        outs = []

        for t in range(K):
            x_t = self.in_proj(x[:, t, :])        # [B, E]
            v = self.decay * v + x_t               # 累积
            # 产生“脉冲”：直通估计的 Heaviside
            spike = (v - self.v_th > 0).float()
            # 训练时的近似导数（STE）
            if self.training:
                spike = spike + (v - self.v_th).clamp(min=-1.0, max=1.0) - (v - self.v_th).detach().clamp(min=-1.0, max=1.0)

            # 膜电位重置（soft reset）
            v_out = v
            v = v * (1.0 - spike)

            if self.readout == "spike":
                outs.append(spike)
            else:
                outs.append(v)

        y = torch.stack(outs, dim=1)  # [B, K, E]
        return y

# ----------------  Transformer 解码器 ----------------
class Decoder(nn.Module):
    def __init__(
        self,
        embed_size,
        num_layers,
        heads,
        forward_expansion,
        dropout=0.1,
        islinear=True,
        use_snn=True,              # <<< 新增：是否启用 SNN 分支
        snn_readout="mem",         # 'mem' 或 'spike'
        fuse_after_each_block=True,# 每个 block 后融合，或只在最后融合
        return_xy=False            # 是否直接输出 (x,y)
    ):
        super(Decoder, self).__init__()

        self.layers = nn.ModuleList(
            [
                TransformerBlock(embed_size, heads, forward_expansion, dropout, islinear=islinear)
                for _ in range(num_layers)
            ]
        )
        self.dropout = nn.Dropout(dropout)

        # --- SNN 分支与融合 ---
        self.use_snn = use_snn
        if use_snn:
            self.snn = LIFLayer(embed_size, readout=snn_readout)
            # 可学习融合权重 alpha：输出 = alpha*TF + (1-alpha)*SNN
            self.alpha = nn.Parameter(torch.tensor(0.5))
        self.fuse_after_each_block = fuse_after_each_block

        # --- 可选输出头：把隐状态映射到 2D 坐标 ---
        self.return_xy = return_xy
        if return_xy:
            self.out_head = nn.Linear(embed_size, 2)

    def forward(self, q, k, mask=None):
        """
        q:   [B, K, E]  —— 解码 Query（例如上一时刻或 learnable queries）
        k:   [B, N, E]  —— 来自 Encoder 的键值（历史特征，可能是 [B,T,E] 或聚合后）
        mask:[B, K, N]  —— 可选，屏蔽无效的 K←V 位置
        return:
            若 return_xy=False: [B, K, E]
            若 return_xy=True : [B, K, 2]
        """
        x = q  # 形状 [B, K, E]

        if self.use_snn and self.fuse_after_each_block:
            # --- 每层后融合一次 ---
            for layer in self.layers:
                x_tf = layer(x, k, k, mask)    # Transformer 分支
                x_snn = self.snn(x_tf)         # SNN 分支接收当前隐状态
                a = torch.sigmoid(self.alpha)
                x = a * x_tf + (1.0 - a) * x_snn

        else:
            # --- 纯 Transformer 堆叠，最后一次性融合 ---
            for layer in self.layers:
                x = layer(x, k, k, mask)
            if self.use_snn:
                x_snn = self.snn(x)
                x = self.alpha * x + (1.0 - self.alpha) * x_snn

        if self.return_xy:
            return self.out_head(x)  # [B, K, 2]
        return x                     # [B, K, E]


class TransformerBlock(nn.Module):
    def __init__(self, embed_size, head, forward_expansion, dropout, islinear=True):
        super(TransformerBlock, self).__init__()
        self.attn = MultihHeadAttention(embed_size, head, islinear=islinear)
        self.norm1 = LayerNorm(embed_size)
        self.norm2 = LayerNorm(embed_size)
        self.feed_forward = FeedForwardLayer(embed_size, forward_expansion)
        self.dropout = nn.Dropout(dropout)

    def forward(self, query, key, value, mask):
        # query [B K E], key/value [B N E], mask [B K N]
        logits = self.attn(query, key, value, mask)  # [B K E]
        x = self.dropout(self.norm1(logits + query))
        forward = self.feed_forward(x)
        out = self.dropout(self.norm2(forward + x))
        return out


class FeedForwardLayer(nn.Module):
    def __init__(self, d_model, forward_expansion):
        super(FeedForwardLayer, self).__init__()
        self.w1 = nn.Linear(d_model, d_model*forward_expansion)
        self.w2 = nn.Linear(d_model*forward_expansion, d_model)

    def forward(self, x):
        return self.w2((F.relu(self.w1(x))))


class LayerNorm(nn.Module):
    def __init__(self, embedding_dim, eps=1e-6):
        super(LayerNorm, self).__init__()
        self.a = nn.Parameter(torch.ones(embedding_dim))
        self.b = nn.Parameter(torch.zeros(embedding_dim))
        self.eps = eps

    def forward(self, x):
        mean = x.mean(-1, keepdim=True)
        std = x.std(-1, keepdim=True)
        return self.a * (x-mean) / (std+self.eps) + self.b


class MultihHeadAttention(nn.Module):
    def __init__(self, d_model, h, dropout=0.1, islinear=True):
        super(MultihHeadAttention, self).__init__()
        assert d_model % h == 0
        self.d_k = d_model // h
        self.h = h

        self.w_key = nn.Linear(d_model, d_model) if islinear else nn.Sequential(
            nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, d_model))
        self.w_query = nn.Linear(d_model, d_model) if islinear else nn.Sequential(
            nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, d_model))
        self.w_value = nn.Linear(d_model, d_model)
        self.fc_out = nn.Linear(d_model, d_model)

        self.dropout = nn.Dropout(dropout)
        self.atten = None

    def forward(self, query, key, value, mask=None):
        # query [B K E], key/value [B N E], mask [B K N]
        if mask is not None:
            # 扩到 [B, h, K, N]
            mask = mask.unsqueeze(1).repeat(1, self.h, 1, 1)

        B = query.size(0)
        E = query.size(-1)

        q = self.w_query(query).view(B, -1, self.h, self.d_k).transpose(1, 2)  # [B,h,K,d_k]
        k = self.w_key(key).view(B, -1, self.h, self.d_k).transpose(1, 2)      # [B,h,N,d_k]
        v = self.w_value(value).view(B, -1, self.h, self.d_k).transpose(1, 2)  # [B,h,N,d_k]

        d_k = q.size(-1)
        scores = torch.matmul(q, k.transpose(-2, -1)) / math.sqrt(d_k)          # [B,h,K,N]
        if mask is not None:
            scores = scores.masked_fill(mask == 0, -1e9)

        scores = F.softmax(scores, dim=-1)
        scores = self.dropout(scores)
        x = torch.matmul(scores, v)                                             # [B,h,K,d_k]

        x = x.transpose(1, 2).contiguous().view(B, -1, self.h * self.d_k)       # [B,K,E]
        return self.fc_out(x)                                                   # [B,K,E]
