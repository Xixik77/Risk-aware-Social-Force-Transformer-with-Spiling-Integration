import torch
import torch.nn as nn
import math
from torch.nn import functional as F
from snn_layers import LIFLayer


# ---- 位置编码 ----
class PositionalEncoding(nn.Module):
    def __init__(self, d_model, max_len=5000):
        super().__init__()
        pe = torch.zeros(max_len, d_model, dtype=torch.float32)
        position = torch.arange(0, max_len, dtype=torch.float32).unsqueeze(1)
        div_term = torch.exp(torch.arange(0, d_model, 2, dtype=torch.float32) * (-math.log(10000.0) / d_model))
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        self.register_buffer("pe", pe.unsqueeze(0))  # [1, max_len, d_model]

    def forward(self, x):
        # x: [B, T, d_model]
        return x + self.pe[:, :x.size(1), :]

# ---- LayerNorm ----
class LayerNorm(nn.Module):
    def __init__(self, embedding_dim, eps=1e-6):
        super().__init__()
        self.a = nn.Parameter(torch.ones(embedding_dim))
        self.b = nn.Parameter(torch.zeros(embedding_dim))
        self.eps = eps

    def forward(self, x):
        mean = x.mean(-1, keepdim=True)
        std = x.std(-1, keepdim=True)
        return self.a * (x - mean) / (std + self.eps) + self.b

# ---- FFN ----
class FeedForwardLayer(nn.Module):
    def __init__(self, d_model, forward_expansion):
        super().__init__()
        self.w1 = nn.Linear(d_model, d_model * forward_expansion)
        self.w2 = nn.Linear(d_model * forward_expansion, d_model)

    def forward(self, x):
        return self.w2(F.relu(self.w1(x)))

# ---- Scaled Dot-Product Attention ----
def attention(query, key, value, mask=None, dropout=None):
    # query/key/value: [B, h, L, d_k]
    d_k = query.size(-1)
    scores = torch.matmul(query, key.transpose(-2, -1)) / math.sqrt(d_k)  # [B,h,Lq,Lk]

    if mask is not None:
        # mask 期望 [B,1,1,Lk] 可广播到 scores
        scores = scores.masked_fill(mask == 0, -1e9)

    scores = F.softmax(scores, dim=-1)
    if dropout is not None:
        scores = dropout(scores)

    out = torch.matmul(scores, value)  # [B,h,Lq,d_k]
    return out, scores

# ---- MHA ----
class MultihHeadAttention(nn.Module):
    def __init__(self, d_model, h, dropout=0.1, islinear=True, use_social=True):
        super().__init__()
        assert d_model % h == 0
        self.d_k = d_model // h
        self.h = h

        self.w_key   = nn.Linear(d_model, d_model) if islinear else nn.Sequential(
            nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, d_model))
        self.w_query = nn.Linear(d_model, d_model) if islinear else nn.Sequential(
            nn.Linear(d_model, d_model), nn.ReLU(), nn.Linear(d_model, d_model))
        self.w_value = nn.Linear(d_model, d_model)
        self.fc_out  = nn.Linear(d_model, d_model)

        self.dropout = nn.Dropout(dropout)
        self.atten = None

        self.use_social = use_social
        if self.use_social:
            self.w_social = nn.Linear(1, 1, bias=False)  # 预留：社会力权重（暂未使用）

    def forward(self, query, key, value, mask=None):
        # 输入期望: [B, L, d_model]
        if mask is not None:
            # 兼容 [B, Lk] → [B,1,1,Lk]
            if mask.dim() == 2:
                mask = mask[:, None, None, :]
            elif mask.dim() == 3:
                mask = mask[:, None, :, :]  # 尽量扩成 4 维

        B = query.size(0)

        # 线性映射
        query = self.w_query(query).view(B, -1, self.h, self.d_k).transpose(1, 2)  # [B,h,Lq,d_k]
        key   = self.w_key(key).view(B, -1, self.h, self.d_k).transpose(1, 2)      # [B,h,Lk,d_k]
        value = self.w_value(value).view(B, -1, self.h, self.d_k).transpose(1, 2)   # [B,h,Lk,d_k]

        # 注意力
        x, self.atten = attention(query, key, value, mask, self.dropout)            # [B,h,Lq,d_k]

        # 合并头
        x = x.transpose(1, 2).contiguous().view(B, -1, self.h * self.d_k)           # [B,Lq,d_model]
        return self.fc_out(x)                                                       # [B,Lq,d_model]

# ---- Transformer Block ----
class TransformerBlock(nn.Module):
    def __init__(self, embed_size, head, forward_expansion, dropout, islinear=True):
        super().__init__()
        self.attn = MultihHeadAttention(embed_size, head, islinear=islinear)
        self.norm1 = LayerNorm(embed_size)
        self.norm2 = LayerNorm(embed_size)
        self.feed_forward = FeedForwardLayer(embed_size, forward_expansion)
        self.dropout = nn.Dropout(dropout)

    def forward(self, query, key, value, mask):
        logits = self.attn(query, key, value, mask)     # [B,L,E]
        x = self.dropout(self.norm1(logits + query))    # 残差
        forward = self.feed_forward(x)                  # FFN
        out = self.dropout(self.norm2(forward + x))     # 残差
        return out

class Encoder(nn.Module):
    def __init__(self, embed_size, num_layers, heads, forward_expansion, dropout=0.1, islinear=True, use_snn=True):
        super().__init__()

        self.use_snn = use_snn
        self.input_proj = nn.Linear(6, embed_size)
        # 位置编码
        self.pos_encoding = PositionalEncoding(embed_size)

        # ========== ANN 分支：原来的 Transformer 编码栈 ==========
        self.layers = nn.ModuleList([
            TransformerBlock(embed_size, heads, forward_expansion, dropout, islinear=islinear)
            for _ in range(num_layers)
        ])
        self.dropout = nn.Dropout(dropout)

        # ========== SNN 分支 ==========
        # 对同样的 [B,T,E] 做 LIF 时间动态
        if self.use_snn:
            self.snn_layer = LIFLayer(tau=2.0, v_th=1.0)
            self.snn_proj = nn.Linear(embed_size, embed_size)
            self.alpha = nn.Parameter(torch.tensor(0.5))
        else:
            self.snn_layer = None
            self.snn_proj = None
            self.alpha = None
        # ========== SNN 分支结束 ==========

        # 融合参数
        self.lambda_ = nn.Parameter(torch.tensor(0.5))
        # 交叉注意力
        self.cross_attn = MultihHeadAttention(embed_size, heads)


    def forward(self, x, mask=None):
        """
        x: [B, T, 6]  ->  输出 [B, T, E]
        """
        # 1) 输入投影 + 位置编码
        x0 = self.input_proj(x)            # [B,T,E]
        x0 = self.pos_encoding(x0)

        # 2) ANN 分支：原 Transformer 编码栈
        x_ann = x0
        for layer in self.layers:
            x_ann = layer(x_ann, x_ann, x_ann, mask)   # 自注意力 + FFN

        # 3) 如果不使用 SNN，直接返回 ANN 分支
        if not self.use_snn:
            return x_ann

        # 4) SNN 分支：LIF 时间动态 + 线性投影
        x_snn_raw = self.snn_layer(x0)  # [B,T,E]
        x_snn = self.snn_proj(x_snn_raw)

        # 5) 融合
        alpha = torch.sigmoid(self.alpha)  # (0,1)
        x_fused = alpha * x_ann + (1.0 - alpha) * x_snn

        return x_fused                     # [B,T,E]



    # 第二阶段：主体-邻居交互
    def forward_with_neighbors(self, ped_traj, neis_traj, Fij=None, mask=None):
        F_self = self.forward(ped_traj, mask)  # [B,T,E]
        H      = self.forward(neis_traj, mask) # [B,T,E]  (注意：若真实是 [B,T,N,6]，需先reshape/聚合到 [B,T,6] 再投影编码)
        F_neigh = self.cross_attn(F_self, H, H, mask)  # [B,T,E]；不解包两个！
        F = self.lambda_ * F_self + (1.0 - self.lambda_) * F_neigh
        return F
